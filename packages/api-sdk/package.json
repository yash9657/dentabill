{
  "name": "@dentabill/api-sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Type-safe client for the @dentabill/api Fastify server. Types generated from the OpenAPI spec — see ADR-017.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.gen.ts"
  },
  "files": [
    "src",
    "openapi.json",
    "package.json"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo 'no build for api-sdk (sources are consumed directly)'",
    "gen:types": "openapi-typescript ./openapi.json -o ./src/types.gen.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@dentabill/config": "workspace:*",
    "openapi-typescript": "^7.4.0",
    "vitest": "^2.1.9"
  }
}
