{
  "name": "@dentabill/billing-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Daily Stripe metered-billing reconciliation worker (Phase 4).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo 'no build artifact for the worker — start uses tsx; tsc-emit deferred to Phase 5 cloud target'",
    "start": "tsx src/bin.ts",
    "cron:once": "tsx src/bin-once.ts"
  },
  "dependencies": {
    "@dentabill/billing": "workspace:*",
    "@dentabill/db": "workspace:*",
    "@dentabill/logger": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dentabill/config": "workspace:*",
    "@types/node": "^20.17.6",
    "tsx": "^4.16.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
