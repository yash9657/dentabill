{
  "name": "@dentabill/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DentaBill Next.js 15 frontend (marketing site + authenticated dashboard).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "analyze": "ANALYZE=1 next build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lighthouse": "lhci autorun --config=.lighthouserc.cjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.9",
    "@dentabill/api-sdk": "workspace:*",
    "@dentabill/types": "workspace:*",
    "@dentabill/ui": "workspace:*",
    "@hookform/resolvers": "3.10.0",
    "@next/bundle-analyzer": "^15.5.19",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.4",
    "lucide-react": "^1.22.0",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@dentabill/config": "workspace:*",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.10.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.0",
    "vitest": "^2.1.9"
  }
}
