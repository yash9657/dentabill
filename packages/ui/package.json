{
  "name": "@dentabill/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Design tokens, Tailwind preset, and shadcn/ui primitives consumed by apps/web (Phase 2 onward).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./theme.css": "./src/theme.css",
    "./tailwind.preset.css": "./src/tailwind.preset.css"
  },
  "files": [
    "src",
    "package.json"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo 'no build for ui (sources are consumed directly)'"
  },
  "devDependencies": {
    "@dentabill/config": "workspace:*",
    "vitest": "^2.1.9"
  }
}
