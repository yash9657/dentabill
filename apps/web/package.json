{
  "name": "@dentabill/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DentaBill Next.js 15 frontend (marketing site + authenticated dashboard).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@dentabill/types": "workspace:*",
    "@dentabill/ui": "workspace:*",
    "lucide-react": "^1.11.0",
    "next": "^15.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@dentabill/config": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.10.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.0",
    "vitest": "^2.1.9"
  }
}
