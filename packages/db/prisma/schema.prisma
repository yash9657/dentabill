// DentaBill database schema.
//
// SOURCE OF TRUTH: this file. Changes require a migration via
// `pnpm --filter @dentabill/db exec prisma migrate dev --name <slug>`.
//
// Conventions:
//   - cuid() for all primary keys (URL-safe, sortable, no random gaps)
//   - Every multi-tenant model has organizationId; reads must go through
//     `getOrgScopedDb(orgId)` and writes are gated by the org-scope
//     middleware (see packages/db/src/middleware/org-scope.ts).
//   - DOB is stored as patientDOBHash (SHA-256) + patientDOBLast4 — never raw.
//   - PHI fields are bounded; raw transcripts and Claude outputs use Text.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev + Docker images; "rhel-openssl-3.0.x" for Vercel
  // Functions (Amazon Linux 2023) — ADR-053 / docs/DEPLOY_VERCEL.md.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Plan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  BILLING_STAFF
}

enum ClaimStatus {
  PENDING
  IN_QUEUE
  CALLING
  COMPLETED
  DENIED
  NEEDS_INFO
  APPEALING
  RESOLVED
  WRITTEN_OFF
  FAILED
  MANUAL_REVIEW
}

enum CallStatus {
  INITIATED
  NAVIGATING_IVR
  ON_HOLD
  HUMAN_REACHED
  COLLECTING
  COMPLETED
  FAILED
  VOICEMAIL
}

enum PayerCode {
  DELTA_DENTAL_PPO
  DELTA_DENTAL_PREMIER
  CIGNA_DENTAL
  METLIFE_DENTAL
  AETNA_DENTAL
  GUARDIAN_DENTAL
  UNITED_CONCORDIA
  HUMANA_DENTAL
  UNKNOWN
}

enum NextAction {
  RESUBMIT
  APPEAL
  SUBMIT_DOCS
  CALL_BACK
  WRITE_OFF
  RESOLVED
  MANUAL_REVIEW
}

// Mirrors @dentabill/queue's `DLQ_REASONS` (ADR-035 / ADR-038 / ADR-039).
// Stamped on Call.dlqReason whenever a job is routed to calls-dlq so the
// dashboard surfaces the cause without requiring BullMQ admin access.
enum CallDLQReason {
  EXCEEDED_MAX_ATTEMPTS
  EXCEEDED_MAX_DURATION
  EXCEEDED_MAX_HOLD
  CANCELLED_BY_OPERATOR
}

// ─── Models ───────────────────────────────────────────────────────────────

enum CallIntentState {
  READY
  SUBMITTING
  UNKNOWN
  ACCEPTED
  TERMINAL
  CANCELLED
}

enum JobOutboxKind {
  CALL_PLACE
  SUMMARY_GENERATE
}

enum JobOutboxState {
  PENDING
  DELIVERED
  QUARANTINED
  CLOSED
}

enum InferenceProvider {
  SYNTHETIC
  FIREWORKS
}

enum InferenceRunState {
  RESERVED
  SUBMITTING
  UNKNOWN
  RESPONDED
  REJECTED
  APPLIED
}

enum InferenceAttemptState {
  SUBMITTING
  RESPONDED
  UNKNOWN
}

enum ObservationDataClass {
  SYNTHETIC
  PROTECTED
}

enum ObservationReviewDecision {
  ACKNOWLEDGED
  DISMISSED
}

model Organization {
  id                   String    @id @default(cuid())
  clerkOrgId           String    @unique
  name                 String
  npi                  String?
  plan                 Plan      @default(TRIAL)
  callsUsed            Int       @default(0)
  settings             Json      @default("{}")
  // Phase 4: per-org feature flag overrides on top of process-level env
  // flags (ADR-042..049). Flag service is intentionally absent in Phase 4 —
  // env wins by default; this column is the targeted-rollout escape hatch.
  featureFlags         Json      @default("{}")
  // Phase 4 cost-guard: rolling token budget for SummarizerPort calls.
  // Reset window is per-org (calendar day in `summaryTokensResetAt`'s
  // timezone — UTC for Phase 4). Updated inside the Redis distributed
  // lock to make the read-then-spend race impossible.
  summaryTokensUsed    Int       @default(0)
  summaryTokensResetAt DateTime?
  // Phase 4 billing: filled lazily by `BillingPort.ensureCustomer`. NULL
  // until the org has its first resolved claim or visits the billing
  // page — avoids creating empty Stripe customers for trial orgs.
  stripeCustomerId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users                    User[]
  claims                   Claim[]
  calls                    Call[]
  callIntents              CallIntent[]
  jobOutbox                JobOutbox[]
  inferenceBudgets         InferenceBudget[]
  inferenceRuns            InferenceRun[]
  inferenceAttempts        InferenceAttempt[]
  claimObservations        ClaimObservation[]
  observationReviews       ClaimObservationReview[]
  observationRegenerations ObservationRegeneration[]
  callSummaries            CallSummary[]
  payerConfigs             PayerConfig[]
  auditLogs                AuditLog[]
  billingUsageRecords      BillingUsageRecord[]
}

model User {
  id             String   @id @default(cuid())
  clerkUserId    String   @unique
  organizationId String
  role           UserRole @default(BILLING_STAFF)
  email          String
  name           String?
  createdAt      DateTime @default(now())

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs                AuditLog[]
  observationReviews       ClaimObservationReview[]
  observationRegenerations ObservationRegeneration[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Claim {
  id                String      @id @default(cuid())
  organizationId    String
  patientDOBHash    String
  patientDOBLast4   String?
  claimNumber       String
  // CSV provenance is explicit. Legacy/manual claims stay null; display
  // claim numbers are not promoted into source identity.
  sourceSystem      String?     @db.VarChar(32)
  sourceNamespace   String?     @db.VarChar(80)
  sourceClaimId     String?     @db.VarChar(200)
  sourceVersion     String?     @db.VarChar(200)
  sourceContentHash String?     @db.VarChar(64)
  // Nullable for imports without subscriber identity. Missing values block
  // outbound calls until supplied by an authorized source or biller;
  // claim numbers and inferred values are never substitutes.
  subscriberId      String?
  cdtCodes          String[]
  claimAmount       Decimal     @db.Decimal(10, 2)
  payerCode         PayerCode
  serviceDate       DateTime
  submittedDate     DateTime?
  status            ClaimStatus @default(PENDING)
  priority          Int         @default(0)
  lastCallAt        DateTime?
  nextCallAt        DateTime?
  retryCount        Int         @default(0)
  maxRetries        Int         @default(3)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls                    Call[]
  callIntents              CallIntent[]
  observations             ClaimObservation[]
  observationRegenerations ObservationRegeneration[]
  sourceDetails            ClaimSourceDetails?

  @@unique([id, organizationId])
  @@unique([organizationId, sourceSystem, sourceNamespace, sourceClaimId], map: "Claim_source_identity_key")
  @@index([organizationId, claimNumber])
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

// Immutable imported facts, distinct from mutable local claim/workflow fields.
// Compound references and deferred SQL constraints seal the complete snapshot.
model ClaimSourceDetails {
  claimId             String
  organizationId      String
  schemaVersion       Int      @default(1)
  importedClaimAmount Decimal  @db.Decimal(10, 2)
  lineCount           Int
  coverageCount       Int
  createdAt           DateTime @default(now())

  claim     Claim                 @relation(fields: [claimId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lines     ClaimSourceLine[]
  coverages ClaimSourceCoverage[]

  @@id([claimId, organizationId])
  @@index([organizationId, claimId])
}

model ClaimSourceLine {
  id                   String   @id @default(uuid()) @db.Uuid
  claimId              String
  organizationId       String
  sourceLineId         String   @db.VarChar(200)
  sourceProcedureId    String?  @db.VarChar(200)
  position             Int
  procedureCode        String   @db.VarChar(32)
  codeVersion          String?  @db.VarChar(32)
  serviceDate          DateTime @db.Date
  billedAmount         Decimal  @db.Decimal(10, 2)
  quantity             Decimal? @db.Decimal(12, 3)
  treatmentArea        String?  @db.VarChar(80)
  tooth                String?  @db.VarChar(80)
  surface              String?  @db.VarChar(80)
  quadrant             String?  @db.VarChar(80)
  toothRange           String?  @db.VarChar(80)
  toothNumberingSystem String?  @db.VarChar(80)

  details ClaimSourceDetails @relation(fields: [claimId, organizationId], references: [claimId, organizationId], onDelete: Cascade)

  @@unique([organizationId, claimId, sourceLineId])
  @@unique([organizationId, claimId, position])
}

model ClaimSourceCoverage {
  id                    String    @id @default(uuid()) @db.Uuid
  claimId               String
  organizationId        String
  sourceCoverageId      String    @db.VarChar(200)
  sequence              Int
  payerName             String    @db.VarChar(200)
  payerIdentifier       String?   @db.VarChar(200)
  payerIdentifierSystem String?   @db.VarChar(80)
  isClaimCoverage       Boolean
  sourcePlanId          String?   @db.VarChar(200)
  sourceSubscriptionId  String?   @db.VarChar(200)
  subscriberId          String?   @db.VarChar(200)
  patientMemberId       String?   @db.VarChar(200)
  groupNumber           String?   @db.VarChar(200)
  relationship          String?   @db.VarChar(80)
  effectiveDate         DateTime? @db.Date
  terminationDate       DateTime? @db.Date

  details ClaimSourceDetails @relation(fields: [claimId, organizationId], references: [claimId, organizationId], onDelete: Cascade)

  @@unique([organizationId, claimId, sourceCoverageId])
  @@unique([organizationId, claimId, sequence])
}

model Call {
  id                String         @id @default(cuid())
  organizationId    String
  claimId           String
  retellCallId      String         @unique
  retellAgentId     String?
  status            CallStatus     @default(INITIATED)
  ivrNavigated      Boolean        @default(false)
  humanReached      Boolean        @default(false)
  holdTimeSeconds   Int?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  audioQualityScore Float?
  callCostCents     Int?
  // Phase-3 additions (ADR-035 / ADR-038 / ADR-039).
  // attemptNumber: per-claim, per-day attempt counter — capped at 2 by ADR-039.
  // dlqReason:     non-null when this call was routed to calls-dlq.
  attemptNumber     Int            @default(1)
  dlqReason         CallDLQReason?
  // Phase 4 true cancel channel (ADR-047). Postgres-driven, NOT Redis
  // pub/sub — pub/sub has a publish-before-subscribe race that drops
  // cancel signals received before waitForCallEnd() opens its
  // subscription. The call-worker checks this column at waitForCallEnd
  // entry and again every 5s during the call.
  cancelRequestedAt DateTime?
  cancelRequestedBy String?
  createdAt         DateTime       @default(now())

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claim                    Claim                     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  summary                  CallSummary?
  events                   CallEvent[]
  intent                   CallIntent?
  inferenceRuns            InferenceRun[]
  observations             ClaimObservation[]
  observationRegenerations ObservationRegeneration[]

  @@unique([id, claimId, organizationId])
  @@index([organizationId])
  // Single-column claimId index kept for backward compatibility — Postgres
  // can use the composite below for `claimId`-only filters, but Prisma's
  // query plans still cite it directly in some cases. Negligible overhead
  // (one extra btree write per insert; no Call rows in prod yet).
  @@index([claimId])
  // Phase-3 composite index — ADR-039's hold-cap policy queries by
  // (organizationId, claimId, status) within the payer-local day; the
  // API list route also filters by these. Leading organizationId enforces
  // the multi-tenancy boundary at the optimizer level: even a buggy query
  // that forgets to filter by organizationId cannot match cross-org
  // claimId collisions.
  @@index([organizationId, claimId, status])
}

// A submission can be attempted only after READY -> SUBMITTING commits.
// SUBMITTING/UNKNOWN are never made READY again, including after a timeout.
model CallIntent {
  id                         String          @id @default(cuid())
  organizationId             String
  claimId                    String
  idempotencyKey             String
  payerCode                  PayerCode
  attemptNumber              Int
  claimPriority              Int
  claimVersion               DateTime
  state                      CallIntentState @default(READY)
  // Exact outbound request contains PHI. Never copy into audit/log metadata.
  requestPayload             Json?
  requestHash                String?
  callId                     String?         @unique
  submittedAt                DateTime?
  completedAt                DateTime?
  lastErrorCode              String?
  reconciledAt               DateTime?
  reconcileOutcome           String?
  reconcileAvailableAt       DateTime?
  reconcileLeaseExpiresAt    DateTime?
  reconcileLeaseToken        String?
  reconcileAttempts          Int             @default(0)
  callDeadlineAt             DateTime?
  nextObservationAt          DateTime?
  observationLeaseToken      String?
  observationLeaseExpiresAt  DateTime?
  observationAttempts        Int             @default(0)
  lastObservedAt             DateTime?
  observationErrorCode       String?
  observationReviewAt        DateTime?
  stopRequestedAt            DateTime?
  stopReason                 String?
  stopAttempts               Int             @default(0)
  stopLastAttemptAt          DateTime?
  stopAcknowledgedAt         DateTime?
  stopConfirmationDeadlineAt DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claim        Claim        @relation(fields: [claimId, organizationId], references: [id, organizationId], onDelete: Cascade)
  call         Call?        @relation(fields: [callId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  // Migration also enforces one active intent per organization/claim.

  @@unique([callId, claimId, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, claimId, createdAt])
  @@index([organizationId, state, updatedAt])
  @@index([state, nextObservationAt, observationLeaseExpiresAt])
}

// Only validated queue commands (opaque IDs and routing fields), never transcripts.
model JobOutbox {
  id                   String         @id @default(cuid())
  organizationId       String
  kind                 JobOutboxKind
  idempotencyKey       String
  payload              Json
  payloadHash          String
  state                JobOutboxState @default(PENDING)
  availableAt          DateTime       @default(now())
  leaseToken           String?
  leaseExpiresAt       DateTime?
  deliveryAttempts     Int            @default(0)
  deliveryAttemptLimit Int            @default(10)
  recoveryCount        Int            @default(0)
  closedAt             DateTime?
  deliveredAt          DateTime?
  lastErrorCode        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, idempotencyKey])
  @@index([organizationId, state, availableAt])
  @@index([state, availableAt, leaseExpiresAt])
}

// Token allocations are admission controls, not an asserted provider dollar ceiling.
// Unknown allocations remain outstanding across UTC days.
model InferenceBudget {
  id             String   @id @default(cuid())
  organizationId String
  billingDay     String   @db.VarChar(10)
  tokenLimit     BigInt
  baselineTokens BigInt   @default(0)
  knownTokens    BigInt   @default(0)
  reservedTokens BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         InferenceRun[]
  attempts     InferenceAttempt[]

  @@unique([organizationId, billingDay])
  @@index([organizationId, reservedTokens])
}

// Request and result snapshots contain protected evidence. Never log these rows.
// Generation one is the only automatic generation until versioned review is implemented.
model InferenceRun {
  id                  String            @id @default(cuid())
  organizationId      String
  callId              String
  claimId             String
  generation          Int               @default(1)
  regenerationId      String?           @unique
  maxAttempts         Int               @default(1)
  executionDeadlineAt DateTime?
  releasePolicyHash   String?           @db.VarChar(64)
  releaseSnapshot     Json?
  wireRequestHash     String?           @db.VarChar(64)
  claimVersion        DateTime
  sourceHash          String            @db.VarChar(64)
  requestHash         String            @db.VarChar(64)
  provider            InferenceProvider
  releaseId           String
  promptVersion       String
  billingDay          String            @db.VarChar(10)
  tokenAllowance      BigInt
  reservedTokens      BigInt
  totalTokens         BigInt?
  state               InferenceRunState @default(RESERVED)
  requestPayload      Json
  resultPayload       Json?
  receiptHash         String?           @db.VarChar(64)
  leaseToken          String?
  leaseExpiresAt      DateTime?
  submittedAt         DateTime?
  respondedAt         DateTime?
  appliedAt           DateTime?
  reviewAppliedAt     DateTime?
  summaryId           String?           @unique
  lastErrorCode       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call              Call                      @relation(fields: [callId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  budget            InferenceBudget           @relation(fields: [organizationId, billingDay], references: [organizationId, billingDay], onDelete: Restrict)
  observation       ClaimObservation?
  regeneration      ObservationRegeneration?  @relation("RegenerationRun", fields: [regenerationId, claimId, callId, organizationId, generation], references: [id, claimId, callId, organizationId, generation], onDelete: Restrict)
  nextRegenerations ObservationRegeneration[] @relation("PreviousRegenerationRun")
  attempts          InferenceAttempt[]

  @@unique([organizationId, callId, generation])
  @@unique([id, organizationId])
  @@unique([id, claimId, callId, organizationId])
  @@unique([id, claimId, callId, organizationId, generation])
  @@unique([regenerationId, claimId, callId, organizationId, generation])
  @@index([organizationId, state, updatedAt])
  @@index([state, leaseExpiresAt])
}

// Each native HTTP attempt has independent admission, raw evidence, and accounting.
// Nullable usage keeps its full reservation even after another attempt succeeds.
model InferenceAttempt {
  id                 String                @id @default(cuid())
  organizationId     String
  runId              String
  attemptNumber      Int                   @default(1)
  billingDay         String                @db.VarChar(10)
  responsePayload    Json?
  responseRecordedAt DateTime?
  responseHash       String?               @db.VarChar(64)
  completionHash     String?               @db.VarChar(64)
  completionHistory  Json                  @default("[]")
  completedAt        DateTime?
  outcome            String?
  acceptance         String?
  httpStatus         Int?
  elapsedMs          Float?
  state              InferenceAttemptState @default(SUBMITTING)
  tokenAllowance     BigInt
  reservedTokens     BigInt
  totalTokens        BigInt?
  inputTokens        BigInt?
  outputTokens       BigInt?
  cachedInputTokens  BigInt?
  submittedAt        DateTime              @default(now())
  respondedAt        DateTime?
  lastErrorCode      String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          InferenceRun    @relation(fields: [runId, organizationId], references: [id, organizationId], onDelete: Restrict)
  budget       InferenceBudget @relation(fields: [organizationId, billingDay], references: [organizationId, billingDay], onDelete: Restrict)

  @@unique([organizationId, runId, attemptNumber])
  @@index([organizationId, state, submittedAt])
}

// Immutable native evidence. Version records publication sequence; source call chronology
// determines which observation is current, so a late old response cannot supersede a newer call.
model ClaimObservation {
  id                      String               @id @default(cuid())
  organizationId          String
  claimId                 String
  callId                  String
  inferenceRunId          String               @unique
  version                 Int
  claimVersion            DateTime
  digest                  String               @db.VarChar(64)
  previousObservationId   String?
  supersedesObservationId String?
  sourceHash              String               @db.VarChar(64)
  requestHash             String               @db.VarChar(64)
  releaseId               String
  provider                InferenceProvider
  promptVersion           String
  schemaVersion           String
  taskVersion             String
  dataClass               ObservationDataClass
  output                  Json
  sources                 Json
  provenance              Json
  createdAt               DateTime             @default(now())

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  claim                    Claim                     @relation(fields: [claimId, organizationId], references: [id, organizationId], onDelete: Restrict)
  call                     Call                      @relation(fields: [callId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  inferenceRun             InferenceRun              @relation(fields: [inferenceRunId, claimId, callId, organizationId], references: [id, claimId, callId, organizationId], onDelete: Restrict)
  previousObservation      ClaimObservation?         @relation("ObservationHistory", fields: [previousObservationId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  nextObservations         ClaimObservation[]        @relation("ObservationHistory")
  supersedesObservation    ClaimObservation?         @relation("ObservationSupersession", fields: [supersedesObservationId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  supersededByObservations ClaimObservation[]        @relation("ObservationSupersession")
  review                   ClaimObservationReview?
  regenerations            ObservationRegeneration[]

  @@unique([id, claimId, organizationId])
  @@unique([id, claimId, callId, organizationId])
  @@unique([organizationId, claimId, version])
  @@unique([inferenceRunId, claimId, callId, organizationId])
  @@index([organizationId, claimId, createdAt])
  @@index([organizationId, callId])
}

// Explicit human authorization to spend on one new native generation. Immutable;
// its resulting run records execution state without changing the approval snapshot.
model ObservationRegeneration {
  id                           String   @id @default(cuid())
  organizationId               String
  claimId                      String
  callId                       String
  previousObservationId        String
  previousObservationDigest    String   @db.VarChar(64)
  previousRunId                String
  previousGeneration           Int
  generation                   Int
  createdByUserId              String
  createdByRole                UserRole
  reason                       String   @db.VarChar(1000)
  idempotencyKey               String
  claimVersion                 DateTime
  requestPayload               Json
  requestHash                  String   @db.VarChar(64)
  sourceHash                   String   @db.VarChar(64)
  releaseId                    String
  releasePolicyHash            String   @db.VarChar(64)
  implementationArtifactSha256 String   @db.VarChar(64)
  releaseSnapshot              Json
  previewDigest                String   @db.VarChar(64)
  expiresAt                    DateTime
  createdAt                    DateTime @default(now())

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  claim               Claim            @relation(fields: [claimId, organizationId], references: [id, organizationId], onDelete: Restrict)
  call                Call             @relation(fields: [callId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  previousObservation ClaimObservation @relation(fields: [previousObservationId, claimId, callId, organizationId], references: [id, claimId, callId, organizationId], onDelete: Restrict)
  previousRun         InferenceRun     @relation("PreviousRegenerationRun", fields: [previousRunId, claimId, callId, organizationId, previousGeneration], references: [id, claimId, callId, organizationId, generation], onDelete: Restrict)
  createdBy           User             @relation(fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inferenceRun        InferenceRun?    @relation("RegenerationRun")

  @@unique([id, claimId, callId, organizationId, generation])
  @@unique([organizationId, callId, generation])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, claimId, createdAt])
}

// A review records a biller's decision about evidence; it never updates claim/payment state.
model ClaimObservationReview {
  id                String                    @id @default(cuid())
  organizationId    String
  claimId           String
  observationId     String                    @unique
  reviewedByUserId  String
  reviewedByRole    UserRole
  decision          ObservationReviewDecision
  note              String?                   @db.VarChar(1000)
  observationDigest String                    @db.VarChar(64)
  claimVersion      DateTime
  reviewedAt        DateTime                  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  observation  ClaimObservation @relation(fields: [observationId, claimId, organizationId], references: [id, claimId, organizationId], onDelete: Restrict)
  reviewedBy   User             @relation(fields: [reviewedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([observationId, claimId, organizationId])
  @@index([organizationId, claimId, reviewedAt])
}

// PHI-relevant: rawTranscript + claudeSummary may contain patient
// names, dates of service, and denial narrative. Multi-tenancy
// enforcement is mandatory (P4-T1A, ADR-042).
model CallSummary {
  id              String     @id @default(cuid())
  organizationId  String
  callId          String     @unique
  claimStatus     String
  denialReason    String?
  denialCode      String?
  nextAction      NextAction
  confidence      Float?
  repName         String?
  referenceNumber String?
  callbackDate    DateTime?
  amountApproved  Decimal?   @db.Decimal(10, 2)
  notes           String?
  rawTranscript   String     @db.Text
  claudeSummary   String     @db.Text
  createdAt       DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call         Call         @relation(fields: [callId], references: [id], onDelete: Cascade)

  // Operator dashboards filter by org and order by recency. Index
  // serves both the org-scoped read path and the per-org SLO scan.
  @@index([organizationId, createdAt])
}

model CallEvent {
  id        String   @id @default(cuid())
  callId    String
  eventType String
  data      Json     @default("{}")
  timestamp DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  // SSE replay-from-cursor reads the most-recent N events for a call
  // ordered by timestamp; ADR-046 makes this index the durable store
  // for transcript replay (Redis pub/sub is broadcast-only).
  @@index([callId, timestamp])
}

model PayerConfig {
  id             String    @id @default(cuid())
  organizationId String
  payerCode      PayerCode
  enabled        Boolean   @default(true)
  providerNpi    String?
  groupNumber    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, payerCode])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String
  ipAddress      String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
}

// ─── BillingUsageRecord ────────────────────────────────────────────────────
//
// Phase 4 metered-billing receipt log (ADR-043). One row per
// (claim, billingPeriodStart) — composite uniqueness gates double-charge
// even if the daily billing-worker runs twice or Stripe's 24-hour
// idempotency window has expired.
//
// `stripeUsageRecordId` is NULL when STRIPE_METERED_BILLING_ENABLED=off
// (receipt-only "shadow" mode for staging) or when the post fails. The
// daily reconciliation job retries NULL rows with the same idempotency
// key, so a later success collapses to one Stripe record.
model BillingUsageRecord {
  id                  String    @id @default(cuid())
  organizationId      String
  claimId             String
  stripeUsageRecordId String?
  billingPeriodStart  DateTime
  amountCents         Int
  // Stripe idempotency key — `claim.<id>.<billingPeriodStart>`. The
  // 24-hour Stripe window is shorter than our reconciliation interval,
  // so this column is the durable backstop.
  idempotencyKey      String    @unique
  postedAt            DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite uniqueness — one row per claim per billing period. This is
  // the actual double-charge guard; the idempotency key is the
  // belt-and-braces.
  @@unique([claimId, billingPeriodStart])
  @@index([organizationId, billingPeriodStart])
}

// ─── RetellWebhookEvent ───────────────────────────────────────────────────
//
// Transactional provider inbox. A signed normalized payload can arrive before
// the Call registration commits. processedAt, CallEvent, Call status and audit
// commit together; payload is cleared once its tenant-bound event is persisted.
// eventId is derived from documented provider lifecycle identity, not supplied
// by Retell. Unmatched payload retention and account reconciliation need W2 ops.
//
// Intentionally NOT multi-tenant: webhooks arrive without org context and
// the org is derived from the linked Call row at processing time. Keeping
// the table flat avoids forcing the route into a synthetic `organizationId`
// before it has located the Call.
model RetellWebhookEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  retellCallId   String?
  eventType      String
  receivedAt     DateTime  @default(now())
  // A provider-signed event can precede our Call row. Retain normalized
  // evidence until tenant binding and all effects commit atomically.
  payload        Json?
  payloadHash    String?
  processedAt    DateTime?
  organizationId String?

  @@index([retellCallId])
  @@index([retellCallId, processedAt])
}
