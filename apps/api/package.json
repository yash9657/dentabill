{
  "name": "@dentabill/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DentaBill Fastify v5 REST API. Scaffold lands in Phase 2.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed:demo": "tsx scripts/demo-seed.mts",
    "demo:call": "tsx scripts/simulate-live-call.mts",
    "demo:preflight": "tsx scripts/demo-preflight.mts",
    "demo:provision": "tsx scripts/demo-provision.mts",
    "gen:openapi": "tsx scripts/dump-openapi.mts",
    "build:vercel": "pnpm --filter @dentabill/db db:generate && node scripts/build-vercel.mjs",
    "build:lambda": "pnpm --filter @dentabill/db db:generate && node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.1",
    "@clerk/fastify": "^3.1.19",
    "@dentabill/call-worker": "workspace:*",
    "@dentabill/db": "workspace:*",
    "@dentabill/logger": "workspace:*",
    "@dentabill/payer-ivr": "workspace:*",
    "@dentabill/queue": "workspace:*",
    "@dentabill/summarizer": "workspace:*",
    "@dentabill/summary-worker": "workspace:*",
    "@dentabill/types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.4.0",
    "@vercel/functions": "^3.9.11",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.4.1",
    "papaparse": "^5.4.1",
    "pino": "^9.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dentabill/config": "workspace:*",
    "@dentabill/model-gateway": "workspace:*",
    "@types/node": "^20.15.1",
    "@types/papaparse": "^5.3.15",
    "@vercel/nft": "^1.11.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "retell-sdk": "^5.16.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
