# DentaBill — environment variable template.
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored and must NEVER be committed. Production secrets live
# in the deploy platform's secret store (decision deferred per ADR-004).
#
# Every new variable used in code MUST land here first with a comment above
# explaining its purpose. See docs/ENGINEERING_RULES.md.

# ─── Runtime ──────────────────────────────────────────────────────────────────

# Standard Node env. Tools branch on this — do not invent custom values.
NODE_ENV=development

# Disable Turborepo telemetry to avoid first-run prompt and external network call.
TURBO_TELEMETRY_DISABLED=1

# ─── Database (Postgres) ──────────────────────────────────────────────────────

# Postgres connection string. Local dev uses the docker-compose service.
# Production: vendor-managed Postgres TBD per ADR-004.
DATABASE_URL=postgresql://dentabill:dentabill@localhost:5432/dentabill?schema=public

# ─── Cache & Queue (Redis) ────────────────────────────────────────────────────

# BullMQ connection — local docker-compose Redis. Optional when
# JOB_DISPATCH_MODE=inline (ADR-053): unset ⇒ SSE polls Postgres, readyz skips
# Redis. TLS URLs (rediss://) work unchanged.
REDIS_URL=redis://localhost:6379

# Upstash REST (Phase 4+, used by serverless contexts that can't open a TCP
# connection to Redis). Leave blank in pure local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Authentication (Clerk) — used by apps/web and apps/api in Phase 2 ────────

# Server secret. Get from dashboard.clerk.com → API keys.
CLERK_SECRET_KEY=

# Public key safe to ship to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Standard Clerk redirect URLs — keep in sync with the Next.js routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/overview
# After signup we always land on /onboarding. The middleware bounces
# already-onboarded users straight through to /dashboard/overview, so
# this is safe even on a returning Clerk session.
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Voice agent (Retell AI) — used by apps/call-worker in Phase 3 ────────────

# Retell API key — from app.retellai.com.
RETELL_API_KEY=

# Per-payer Retell agent IDs (ADR-032). Each Phase-3 payer has a dedicated
# agent; the call worker resolves the right one from the claim's payer code
# and stamps it onto `Call.retellAgentId`. Empty in dev/test — the FakeRetell
# adapter ignores them.
RETELL_AGENT_ID_DELTA_DENTAL_PPO=
RETELL_AGENT_ID_CIGNA_DENTAL=
RETELL_AGENT_ID_METLIFE_DENTAL=

# HMAC secret for verifying Retell webhook signatures.
RETELL_WEBHOOK_SECRET=

# ─── Demo mode ────────────────────────────────────────────────────────────────

# Drives FakeRetell on real timers so an enqueued job completes a full ~75s
# scripted call instead of hanging to the duration cap. Only activates when
# RETELL_API_KEY is ALSO empty — a real key always wins. Used by apps/call-worker.
DEMO_AUTOPILOT=false

# Skips the payer business-hours guard at enqueue (apps/api). Payer lines are
# closed evenings and weekends, so without this "Call Now" returns 422 exactly
# when a demo is most likely to run. Interlocked against RETELL_API_KEY: a real
# key restores the guard regardless of this flag, so it can never cause a real
# out-of-hours dial.
DEMO_IGNORE_PAYER_HOURS=false

# Lets FakeClaude derive a summary from the transcript instead of throwing when
# no test fixture matches (apps/summary-worker). FakeClaude is fixture-driven,
# so without this a genuine call produces no summary, the job dead-letters, and
# the claim never transitions. Ignored when ANTHROPIC_API_KEY is set.
DEMO_SUMMARIZER_FALLBACK=false

# ─── Summarizer (apps/summary-worker) ─────────────────────────────────────────

# When true, a completed summary transitions the claim automatically and writes
# the decision (summaryId + confidence + promptVersion) to the audit log.
SUMMARIZER_AUTO_TRANSITION_ENABLED=false

# ─── Live transcript (apps/web) ───────────────────────────────────────────────

# Enables the SSE-backed live transcript on the call detail page. Without it the
# view renders the durable CallEvent rows only, with no live stream.
NEXT_PUBLIC_SSE_LIVE_TRANSCRIPT_ENABLED=false

# ─── Telephony (Telnyx) — used by apps/call-worker in Phase 3 ─────────────────

# Telnyx API key — from telnyx.com.
TELNYX_API_KEY=

# Outbound phone number that originates calls to insurance lines.
TELNYX_PHONE_NUMBER=

# ─── LLM (Anthropic) — used by apps/summary-worker in Phase 4 ─────────────────

# Anthropic API key — from console.anthropic.com.
ANTHROPIC_API_KEY=

# ─── Email (Resend) — used by apps/api in Phase 4 ─────────────────────────────

# Resend API key — from resend.com.
RESEND_API_KEY=

# Verified sender. Must match a domain configured in Resend.
RESEND_FROM_EMAIL=noreply@example.com

# ─── Billing (Stripe) — used by apps/web and apps/api in Phase 6 ──────────────

# Stripe server secret.
STRIPE_SECRET_KEY=

# Stripe publishable key (browser-safe).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=

# Posts metered usage to Stripe. Left false under the free-forever model
# (ADR-051 / D2) — BillingUsageRecord rows are still written as receipts, they
# just never reach Stripe. The billing-worker is not deployed.
STRIPE_METERED_BILLING_ENABLED=false

# ─── App URLs ─────────────────────────────────────────────────────────────────

# Public URL of the Next.js app. Local dev uses :3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the Fastify API. Local dev uses :3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Workers ──────────────────────────────────────────────────────────────────

# How jobs run (ADR-053): bullmq = Redis queues + always-on workers (default);
# inline = the API runs jobs itself via /v1/internal/jobs/* (Vercel).
JOB_DISPATCH_MODE=bullmq

# Shared secret for /v1/internal/jobs/* — required when JOB_DISPATCH_MODE=inline.
# Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=

# Origin the inline dispatcher POSTs jobs to. Defaults to the Vercel production
# domain, then VERCEL_URL, then http://127.0.0.1:$PORT.
INTERNAL_API_BASE_URL=

# SSE stream cap (ms) before the client is made to reconnect; defaults to
# 780000 on Vercel, unbounded elsewhere. Poll cadence applies without Redis.
SSE_MAX_STREAM_MS=
SSE_POLL_INTERVAL_MS=1000

# Concurrent BullMQ jobs per worker process.
WORKER_CONCURRENCY=3

# Hard ceiling on call duration before forced termination (milliseconds).
MAX_CALL_DURATION_MS=1800000

# ─── Observability (deferred — Phase 5) ───────────────────────────────────────

# Sentry DSN — leave blank until cloud target is decided per ADR-004.
SENTRY_DSN=
